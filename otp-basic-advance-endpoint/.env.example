# Server
PORT=3050

# RSA private key for Meta Flow encryption.
# Leave empty to auto-generate private.pem + public.pem on first start,
# OR point to an existing key file:
# PRIVATE_KEY_PATH=./private.pem
# PRIVATE_KEY_PASSPHRASE=

# Optional: paste the full PEM inline (use \n for newlines). Prefer PRIVATE_KEY_PATH.
# PRIVATE_KEY=

# Must match screen ids and field names in your Flow JSON.
# Screen 1: fields `name`, `email` — Footer action = data_exchange
# Screen 2: field `otp` — Footer action = data_exchange
# Screen 3: show "Verified" — Footer can complete / data_exchange
FIRST_SCREEN_ID=FORM_SCREEN
OTP_SCREEN_ID=OTP_SCREEN
VERIFIED_SCREEN_ID=VERIFIED

# true = finish the Flow immediately after a valid OTP (SUCCESS)
# false = go to VERIFIED_SCREEN_ID so the Flow can continue
COMPLETE_ON_SUCCESS=false

OTP_TTL_MINUTES=10

# Gmail SMTP — use an App Password, not your normal Gmail password.
SMTP_SERVICE=gmail
SMTP_USER=meghshamjade50@gmail.com
SMTP_FROM=meghshamjade50@gmail.com
SMTP_PASS=
