# Server — use a different port from endpoint-test (3050)
PORT=3051

# RSA private key for Meta Flow encryption.
# Leave empty to auto-generate private.pem + public.pem on first start.
# If this WhatsApp number already has endpoint-test's public key uploaded,
# copy that pair here or point at it:
# PRIVATE_KEY_PATH=../endpoint-test/private.pem
# PRIVATE_KEY_PASSPHRASE=

# PRIVATE_KEY=

# Must match screen ids in your GreenTick Flow JSON.
# Screen 1: name + email + password (Footer = data_exchange)
# Screen 2: continue after a valid login (Footer = data_exchange)
# Screen 3: ${data.name} / ${data.email} from this server
FIRST_SCREEN_ID=LOGIN_SCREEN
MIDDLE_SCREEN_ID=STATUS_SCREEN
SUCCESS_SCREEN_ID=WELCOME

# true = finish the Flow right after a valid login (no welcome screen)
# false = LOGIN -> STATUS -> WELCOME
COMPLETE_ON_SUCCESS=false
